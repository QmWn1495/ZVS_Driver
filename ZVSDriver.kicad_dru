(version 1)
# JLCPCB 2-layer limits that Board Setup->Constraints cannot express.

(rule "JLCPCB plated hole annular ring"
	(constraint annular_width (min 0.25mm))
	(condition "A.Pad_Type == 'Through-hole'"))

(rule "JLCPCB unplated hole to copper"
	(constraint hole_clearance (min 0.5mm))
	(condition "A.Pad_Type == 'NPTH, mechanical'"))

(rule "JLCPCB plated hole size"
	(constraint hole_size (min 0.3mm) (max 6.3mm)))
